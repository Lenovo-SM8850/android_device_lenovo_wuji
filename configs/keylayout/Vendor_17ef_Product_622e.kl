# Lenovo Tab Pen Pro 2: report the top button clicks as standard stylus keys
key usage 0x0c0614   STYLUS_BUTTON_TAIL
key usage 0x0c0601   STYLUS_BUTTON_PRIMARY
key usage 0x0c0610   STYLUS_BUTTON_SECONDARY
key usage 0x0c0611   STYLUS_BUTTON_TERTIARY

# Barrel slide up
key usage 0x0c0613   COPY
# Barrel slide down
key usage 0x0c0612   PASTE
# Tail press
key usage 0x0c0623   STYLUS_BUTTON_TAIL
