# Qualcomm supplies this daemon's domain only on userdebug/eng. The production
# Loader needs its local Unix/QRTR transport, without the debug Binder/USB HAL.
ifelse(target_build_variant, `user', `
type vendor_lenovo_diag_router, domain;
type vendor_lenovo_diag_router_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_lenovo_diag_router)
allow vendor_lenovo_diag_router self:unix_stream_socket create_stream_socket_perms;
allow vendor_lenovo_diag_router self:qipcrtr_socket create_socket_perms_no_ioctl;
allow vendor_lenovo_diag_router self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
r_dir_file(vendor_lenovo_diag_router, vendor_sysfs_soc)
r_dir_file(vendor_lenovo_diag_router, vendor_sysfs_qdss_dev)
')
