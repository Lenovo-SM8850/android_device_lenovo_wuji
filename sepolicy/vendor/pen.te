type vendor_proc_goodix_pen, fs_type, proc_type;
allow vendor_init vendor_proc_goodix_pen:file rw_file_perms;
neverallow system_app vendor_proc_goodix_pen:file { write append };

# Host submission status is readable; only init may request CE/14.
type vendor_proc_pen_haptics, fs_type, proc_type;
allow vendor_init vendor_proc_pen_haptics:file rw_file_perms;
allow system_app vendor_proc_pen_haptics:file r_file_perms;
neverallow system_app vendor_proc_pen_haptics:file { write append };
