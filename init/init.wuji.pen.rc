# SPDX-License-Identifier: Apache-2.0

on post-fs-data
    chown system system /proc/pen_type
    chmod 0660 /proc/pen_type
    chown system system /proc/HighReportRate
    chmod 0660 /proc/HighReportRate
    chown system system /proc/report_threshold
    chown system system /proc/edge_grid_zone
    # Let pen taps wake the screen; the driver applies the mode on suspend.
    write /proc/pen_wakeup_mode 1

# Keep the stock kernel default until a supported identity is reported.
on property:sys.lenovo.pen.type=2
    write /proc/pen_type 2

on property:sys.lenovo.pen.type=6
    write /proc/pen_type 6

# The touch policy service owns the pen connection node.

# Read-only host status for LenovoPen; the app sets only the boolean property.
on post-fs-data
    chown root system /proc/haptics
    chmod 0640 /proc/haptics
    write /proc/haptics 0

on property:sys.lenovo.pen.haptics=1
    write /proc/haptics 1

on property:sys.lenovo.pen.haptics=0
    write /proc/haptics 0
