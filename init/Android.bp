// Device init

prebuilt_etc {
    name: "init.wuji.mcfg-loader.rc",
    vendor: true,
    src: "init.wuji.mcfg-loader.rc",
    sub_dir: "init",
    filename_from_src: true,
}

prebuilt_etc {
    name: "init.wuji.rc",
    required: ["init.lenovo.rc"],
    src: "init.wuji.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// Device fstab.
prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "init.wuji.pen.rc",
    vendor: true,
    src: "init.wuji.pen.rc",
    sub_dir: "init",
    filename_from_src: true,
}

prebuilt_etc {
    name: "ueventd.wuji.rc",
    filename: "ueventd.rc",
    src: "ueventd.wuji.rc",
    required: ["ueventd.lenovo.rc"],
    device_specific: true,
}

sh_binary {
    name: "init.kernel.post_boot-canoe_default_6_2.sh",
    src: "init.kernel.post_boot-canoe_default_6_2.sh",
    vendor: true,
}

