import /vendor/etc/init/hw/init.lenovo.common.rc

on early-init
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2112000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2880000

on charger
    # Leave power-off charging patterns to the stock battery rc.
    stop vendor.light-default

on boot
    # Android owns the ring; charge-only cfg writes are limited to charger mode.
    setprop vendor.lenovo.battery.charge_only_mode 0



on property:vendor.display.lcd_density=640
    setprop dalvik.vm.heapgrowthlimit 512m

service colorbin /vendor/bin/colorbin
    class main
    user system
    group system
    disabled
    oneshot
    seclabel u:r:colorbin:s0
on post-fs
    start colorbin

on property:sys.lenovo.attestationkey=1
    setprop ro.odm.lenovo.attestationkey ${sys.lenovo.attestationkey}

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpu4/online 1
    write /sys/devices/system/cpu/cpu5/online 1
    write /sys/devices/system/cpu/cpu6/online 1
    write /sys/devices/system/cpu/cpu7/online 1
    chmod 0666 sys/devices/platform/soc/941b000.qcom,cci0/941b000.qcom,cci0:qcom,actuator0/moveVCM
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 3628800
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 4742400
