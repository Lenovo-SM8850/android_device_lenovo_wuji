# Camera
ro.camerax.extensions.enabled=true

# Device identity
ro.vendor.config.lgsi.project=wuji

# Display HAL / gralloc
vendor.display.use_smooth_motion=1
vendor.display.lcd_density=360

# SurfaceFlinger refresh policy
ro.surface_flinger.set_touch_timer_ms=3500
ro.surface_flinger.set_refresh_timer_ms=200
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.set_launcher_timer_ms=30000
ro.surface_flinger.set_pen_timer_ms=10000
