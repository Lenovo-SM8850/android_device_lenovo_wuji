# Device identity
ro.vendor.config.lgsi.project=wuji

# Display HAL / gralloc
vendor.display.use_smooth_motion=1
vendor.display.lcd_density=360

# Display P3 vendor render intent
persist.sys.sf.native_mode=300

# Cellular network coexistence (QMS)
persist.vendor.data.mutualex.mode=wifipreferred

# Cellular data path management (DPM)
persist.vendor.dpm.vndr.feature=11

# Dual SIM dual standby
persist.radio.multisim.config=dsds

# Functional stock vendor defaults
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enableadvancedscan=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.sib16_support=1
persist.vendor.rcs.singlereg.feature=2

# SurfaceFlinger refresh policy
ro.surface_flinger.set_touch_timer_ms=3500
ro.surface_flinger.set_refresh_timer_ms=200
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.set_launcher_timer_ms=30000
ro.surface_flinger.set_pen_timer_ms=10000

# Sensors
sensor.barometer.high_quality.implemented=true
